# Kopieren Sie diese Datei nach .env.local und tragen Sie Ihre Werte ein.
# .env.local wird nicht hochgeladen — Schluessel gehoeren nie ins Repository.

# --- Ablage ueber MCP (seit Dienstag) --------------------------------------
# Welcher Ordner ueber MCP erreichbar sein soll. Genau einer, so eng wie
# moeglich — nicht das ganze Benutzerverzeichnis.
ABLAGE_ORDNER=/Users/ihrname/Dokumente/Projektablage

# --- Datenbank (seit Mittwoch) ---------------------------------------------
# Beide Werte stehen im Supabase-Dashboard unter Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://ihr-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
